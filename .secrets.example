# Staging file for the hybrid hosted demo reset (gitignored: .secrets).
# Used by .github/workflows/demo-reset.yml after you copy values into GitHub.
#
# Generate local values (creates .secrets only when missing):
#   npm run env:init:secrets
#   # overwrite / rotate token: npm run env:init:secrets -- --force
#
# Do not commit .secrets. Keep GitHub variable DEMO_API_BASE_URL=disabled until the
# API is live (job skipped, no runner minutes). Then set it to your https origin.
#
# Map into GitHub (Settings -> Secrets and variables -> Actions):
#   DEMO_API_BASE_URL -> Repository *variable* (disabled, or public https origin)
#   DEMO_RESET_TOKEN  -> Repository *secret* (same value as VM .env DEMO_RESET_TOKEN)

# Public HTTPS origin of the hosted API (no path). Placeholder until first deploy.
DEMO_API_BASE_URL=https://api.example.com

# High-entropy token (>= 32 chars). Empty here; env:init:secrets fills .secrets.
# Header on POST /v1/admin/demo/reset: X-Demo-Reset-Token
DEMO_RESET_TOKEN=
