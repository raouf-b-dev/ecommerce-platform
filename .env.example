# ecommerce-platform configuration.
#
# Create .env before the first start:
#   npm run env:init
#   # or: cp .env.example .env
#
# Every value below is a demo default for a local machine unless a section says
# otherwise. Local demo passwords are public by design. Compose stops with an
# error if a required variable is missing, so keep every key.
# Do not reuse laptop demo passwords/keys on a host reachable from the internet.
# Hosted secrets (tunnel token, DEMO_RESET_TOKEN, strong DB/Redis/JWT material)
# live on the VM / in GitHub Actions / Cloudflare - never commit real values.

# ---------------------------------------------------------------------------
# Application versions (see the version matrix in README.md)
# ---------------------------------------------------------------------------

# ghcr.io/raouf-b-dev/ecommerce-store-api (and -seed) image tag (no leading v).
ECOM_API_VERSION=0.13.0

# ghcr.io/raouf-b-dev/ecommerce-admin-dashboard image tag (no leading v).
ECOM_ADMIN_VERSION=0.8.0

# ghcr.io/raouf-b-dev/ecommerce-store-web image tag (no leading v).
ECOM_WEB_VERSION=0.7.0

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change a port here if it is already in use. On some Windows hosts Hyper-V
# reserves 3000-3199 (check: netsh interface ipv4 show excludedportrange
# protocol=tcp). After changing API_PORT, restart the stack so admin/web pick
# up API_BASE_URL (and web API_INTERNAL_BASE_URL) from this file.

API_PORT=3000
ADMIN_PORT=5174
WEB_PORT=3100

# Observability profile only (docker compose --profile observability up -d).
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce-demo
POSTGRES_DB=ecommerce
REDIS_PASSWORD=ecommerce-demo

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------

# staging: allows PAYMENT_MOCK_AUTO_COMPLETE for demo checkout on API 0.11.x
# while keeping production-like defaults otherwise. Do not use production here
# with mock auto-complete.
API_NODE_ENV=staging

# true: checkouts confirm through a simulated payment webhook (mock Stripe).
PAYMENT_MOCK_AUTO_COMPLETE=true

# ISO 4217 store currency, validated by the API at startup.
STORE_DEFAULT_CURRENCY=USD

# error | warn | info | http | verbose | debug | silly
API_LOG_LEVEL=info

# Bearer token for GET /metrics (Prometheus uses it in the observability
# profile). Demo value only.
METRICS_API_KEY=demo-metrics-key

# The JWT signing key is not configured here. The jwt-keygen service creates
# one in the jwt_keys volume on first start.

# ---------------------------------------------------------------------------
# Hosted demo (overrides/compose.hosted-api.yaml only)
# ---------------------------------------------------------------------------
# Local `docker compose up` ignores these. The API-tier overlay requires them.
# Placeholders only: replace with your real https origins on the VM.
# See docs/HOSTED-DEMO.md. Match API env names exactly (API 0.13+).

# Public origin browsers use to reach the API (scheme + host, no path).
PUBLIC_BASE_URL=https://api.example.com

# Exact UI origins (comma-separated). Credentials enabled; never use *.
CORS_ALLOWED_ORIGINS=https://admin.example.com,https://shop.example.com

# none = cross-origin Pages/Vercel refresh cookie (requires https PUBLIC_BASE_URL).
# Local full Compose does not read this key; the API image default stays strict.
AUTH_COOKIE_SAMESITE=none

# Hosted reset endpoint. Keep false until the VM has a strong token configured.
DEMO_RESET_ENABLED=false

# Empty in git. On the VM set >= 32 characters; same value as GitHub secret
# DEMO_RESET_TOKEN. Header: X-Demo-Reset-Token. Never commit a real token.
# Stage a generated token locally with: npm run env:init:secrets (see .secrets.example).
DEMO_RESET_TOKEN=

# Shared public demo (API 0.13+): true seeds the read-only viewer
# (ADMIN_READONLY) as the only account: no writable operators, no demo
# customer, cart, orders, or payments. Mutations stay on API RBAC; the viewer
# cannot change its password or log out everywhere, and sees no customer
# personal data. Storefront visitors register their own accounts. Leave false
# for local Compose.
DEMO_READ_ONLY=false
# Public hosted-demo login (the only DEMO_* account the overlay passes through;
# defaults match the API .env.example). DEMO_SUPERADMIN_*, DEMO_ADMIN_* and
# DEMO_CUSTOMER_* are for local seeding only: local Compose uses the API image
# defaults listed in the README, and the hosted overlay does not pass them.
DEMO_VIEWER_EMAIL=viewer@store.local
DEMO_VIEWER_PASSWORD=Viewer123!

# ---------------------------------------------------------------------------
# Observability profile
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
