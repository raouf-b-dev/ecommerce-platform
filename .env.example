# ecommerce-platform configuration.
#
# Copy this file to .env before the first start:
#   cp .env.example .env
#
# Every value below is a demo default for a local machine. None of them is a
# real secret. Compose stops with an error if a required variable is missing,
# so keep every key. Do not reuse these values on a server that is reachable
# from the internet.

# ---------------------------------------------------------------------------
# Application versions (see the version matrix in README.md)
# ---------------------------------------------------------------------------

# ghcr.io/raouf-b-dev/ecommerce-store-api image tag (no leading v).
# 0.11.0 is published but its entrypoint cannot run migrations (FINDINGS.md,
# gap G2), so the demo pins 0.10.0. Admin 0.6.0 and web 0.5.0 support API
# 0.10.0 or later.
ECOM_API_VERSION=0.10.0

# ghcr.io/raouf-b-dev/ecommerce-admin-dashboard image tag (no leading v).
ECOM_ADMIN_VERSION=0.6.0

# ghcr.io/raouf-b-dev/ecommerce-store-web image tag (no leading v).
ECOM_WEB_VERSION=0.5.0

# ---------------------------------------------------------------------------
# Build sources
# ---------------------------------------------------------------------------
# Used only where no usable image is published yet: the demo seed (API) and,
# until their images exist, the admin dashboard and the storefront. Docker
# fetches the tagged source itself; you do not need Git or Node.js.
# To build from local clones instead, point these at sibling folders, for
# example ADMIN_SOURCE=../ecommerce-admin-dashboard

API_SOURCE=https://github.com/raouf-b-dev/ecommerce-store-api.git#v${ECOM_API_VERSION}
ADMIN_SOURCE=https://github.com/raouf-b-dev/ecommerce-admin-dashboard.git#v${ECOM_ADMIN_VERSION}
WEB_SOURCE=https://github.com/raouf-b-dev/ecommerce-store-web.git#v${ECOM_WEB_VERSION}

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change a port here if it is already in use. On some Windows hosts Hyper-V
# reserves 3000-3199 (check: netsh interface ipv4 show excludedportrange
# protocol=tcp). API_PORT and WEB_PORT are compiled into the frontends, so
# after changing them run: docker compose build admin web

API_PORT=3000
ADMIN_PORT=5174
WEB_PORT=3100

# Observability profile only (docker compose --profile observability up -d).
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce-demo
POSTGRES_DB=ecommerce
REDIS_PASSWORD=ecommerce-demo

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------

# API 0.10.0 accepts PAYMENT_MOCK_AUTO_COMPLETE=true only in development or
# test, and the demo needs it so checkouts complete without Stripe. The image
# is still the production build; development only enables Swagger and error
# details in responses. Use staging once you pin API 0.11.x or later.
API_NODE_ENV=development

# true: checkouts confirm through a simulated payment webhook (mock Stripe).
PAYMENT_MOCK_AUTO_COMPLETE=true

# ISO 4217 store currency, validated by the API at startup.
STORE_DEFAULT_CURRENCY=USD

# error | warn | info | http | verbose | debug | silly
API_LOG_LEVEL=info

# Bearer token for GET /metrics (Prometheus uses it in the observability
# profile). Demo value only.
METRICS_API_KEY=demo-metrics-key

# The JWT signing key is not configured here. The jwt-keygen service creates
# one in the jwt_keys volume on first start.

# ---------------------------------------------------------------------------
# Observability profile
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
