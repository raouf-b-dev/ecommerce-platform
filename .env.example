# ecommerce-platform configuration.
#
# Create .env before the first start:
#   npm run env:init
#   # or: cp .env.example .env
#
# Every value below is a demo default for a local machine. None of them is a
# real secret. Compose stops with an error if a required variable is missing,
# so keep every key. Do not reuse these values on a server that is reachable
# from the internet.

# ---------------------------------------------------------------------------
# Application versions (see the version matrix in README.md)
# ---------------------------------------------------------------------------

# ghcr.io/raouf-b-dev/ecommerce-store-api (and -seed) image tag (no leading v).
ECOM_API_VERSION=0.11.1

# ghcr.io/raouf-b-dev/ecommerce-admin-dashboard image tag (no leading v).
ECOM_ADMIN_VERSION=0.7.0

# ghcr.io/raouf-b-dev/ecommerce-store-web image tag (no leading v).
ECOM_WEB_VERSION=0.6.0

# ---------------------------------------------------------------------------
# Host ports
# ---------------------------------------------------------------------------
# Change a port here if it is already in use. On some Windows hosts Hyper-V
# reserves 3000-3199 (check: netsh interface ipv4 show excludedportrange
# protocol=tcp). After changing API_PORT, restart the stack so admin/web pick
# up API_BASE_URL (and web API_INTERNAL_BASE_URL) from this file.

API_PORT=3000
ADMIN_PORT=5174
WEB_PORT=3100

# Observability profile only (docker compose --profile observability up -d).
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090

# ---------------------------------------------------------------------------
# Data stores
# ---------------------------------------------------------------------------

POSTGRES_USER=ecommerce
POSTGRES_PASSWORD=ecommerce-demo
POSTGRES_DB=ecommerce
REDIS_PASSWORD=ecommerce-demo

# ---------------------------------------------------------------------------
# API runtime
# ---------------------------------------------------------------------------

# staging: allows PAYMENT_MOCK_AUTO_COMPLETE for demo checkout on API 0.11.x
# while keeping production-like defaults otherwise. Do not use production here
# with mock auto-complete.
API_NODE_ENV=staging

# true: checkouts confirm through a simulated payment webhook (mock Stripe).
PAYMENT_MOCK_AUTO_COMPLETE=true

# ISO 4217 store currency, validated by the API at startup.
STORE_DEFAULT_CURRENCY=USD

# error | warn | info | http | verbose | debug | silly
API_LOG_LEVEL=info

# Bearer token for GET /metrics (Prometheus uses it in the observability
# profile). Demo value only.
METRICS_API_KEY=demo-metrics-key

# The JWT signing key is not configured here. The jwt-keygen service creates
# one in the jwt_keys volume on first start.

# ---------------------------------------------------------------------------
# Observability profile
# ---------------------------------------------------------------------------

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
